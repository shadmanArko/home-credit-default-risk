# Keep directory structure
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ============================================================
# ML artifacts
# ============================================================

models/*
!models/.gitkeep

# Generated reports
reports/*
!reports/.gitkeep

# Data profiling artifacts are committed on purpose (small, structured,
# versioned source of truth for both humans and future LLM sessions).
# The DuckDB landing cache is a large throwaway intermediate — not committed.
!reports/data_profile/
reports/data_profile/*.duckdb
reports/data_profile/*.duckdb.wal
!reports/data_profile/*.json
!reports/data_dictionary.md
!reports/data_quality_summary.md
!reports/reproducibility_check.md
!reports/experiments.csv

# Drift monitoring (HC-M4-12/13) — the generated HTML report itself is a
# large, regenerable Evidently bundle, same reasoning as the Sweetviz
# report above; the write-up interpreting it is the versioned artifact.
!reports/monitoring/
reports/monitoring/*.html
!reports/monitoring/drift_report_notes.md

# ============================================================
# MLflow (Milestone 4 — HC-M4-01..03)
# ============================================================

# Local SQLite tracking store + artifact store — regenerate via
# scripts/train_with_mlflow.py, never committed (same reasoning as the
# DuckDB landing cache above: large, regenerable, not source of truth).
mlflow.db
mlruns/
mlartifacts/